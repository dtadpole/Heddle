{
  "name": "heveld",
  "version": "0.1.0",
  "private": true,
  "description": "A harness and agent framework built on Cordis, in TypeScript.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "heveld": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node src/cli.ts",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
